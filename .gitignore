# ============================================================
#  pruebas-sso-gore-cusco - .gitignore (raiz)
#  Aplica a los tres proyectos: prueba-externo,
#  prueba-institucional y prueba-mixto.
# ============================================================

# --- Credenciales y configuracion local (NUNCA subir) ---
# .npmrc guarda el token del registro npm privado (GitLab).
# Cada desarrollador crea el suyo localmente.
.npmrc
.env
.env.*
*.pem
*.key
*.p12
*.pfx

# --- Dependencias ---
node_modules/

# --- Salidas de compilacion ---
dist/
tmp/
out-tsc/
bazel-out/

# --- Angular ---
.angular/
.sass-cache/
connect.lock
coverage/
libpeerconnection.log
testem.log
typings/

# --- Logs ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# --- IDEs y editores ---
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
.history/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# --- Archivos del sistema ---
.DS_Store
Thumbs.db
desktop.ini
